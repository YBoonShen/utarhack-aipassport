# Copy this file to .env and fill in real values (never commit .env!)
PORT=5001
# Firebase — see backend/FIREBASE_SETUP.md for the full walkthrough.
# Auth + Firestore turn on once backend/serviceAccount.json exists (gitignored);
# until then the app runs fine in offline mode.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-api-key
# Optional: point at a service-account key somewhere other than
# backend/serviceAccount.json (e.g. a mounted secret in deployment).
# FIREBASE_SERVICE_ACCOUNT=/path/to/serviceAccount.json
# Gemini API key for Layer 2 detection (https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-key

# ---- Google single sign-on --------------------------------------------------
# Leave GOOGLE_CLIENT_ID unset and the sign-in screen shows a demo Google
# chooser with the two seeded organisation accounts — enough to demonstrate SSO
# on a laptop with no Google project. Set it and you get the real thing: the
# browser runs Google Identity Services and the server verifies the ID token
# (signature, audience, issuer, expiry, email_verified) before anybody is signed
# in. Setting it also turns the demo chooser off completely.
#
# Get one at https://console.cloud.google.com/apis/credentials
#   > Create credentials > OAuth client ID > Web application
#   > Authorised JavaScript origins: http://localhost:5173
GOOGLE_CLIENT_ID=
# Which email domains may sign in with Google. A first-time Google signer on an
# allowed domain is provisioned as an employee at Level 1; anyone else is
# refused. Comma-separated.
SSO_ALLOWED_DOMAINS=abcd.com

# ---- Seeded accounts --------------------------------------------------------
# The two provisioned identities: the demo employee (Tan Jia Yin, E-217, default
# AI tool ChatGPT) and the compliance administrator. Passwords default to
# Passport#2026 / AdminPass#2026 and are printed once at startup while they are
# still the defaults. CHANGE THESE for anything that is not a local demo.
SEED_EMPLOYEE_EMAIL=jiayin.tan@abcd.com
SEED_EMPLOYEE_PASSWORD=
SEED_ADMIN_EMAIL=admin@abcd.com
SEED_ADMIN_PASSWORD=

# Copy to frontend/.env and fill in from Firebase Console > Project settings >
# Your apps > Web app (see backend/FIREBASE_SETUP.md). These values are PUBLIC by
# design — Firebase secures data with rules, not by hiding the web config.
#
# Leave these unset and the "Sign in with Google (Firebase)" button simply does
# not appear; email/password and demo SSO sign-in work as before.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

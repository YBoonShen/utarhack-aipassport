{
  "manifest_version": 3,
  "name": "AI Passport — Smart Gateway",
  "version": "1.0.0",
  "description": "Checks prompts for personal data before they leave your browser, using your organisation's AI Passport Smart Gateway.",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.deepseek.com/*",
    "https://kimi.com/*",
    "https://*.kimi.com/*",
    "https://moonshot.cn/*",
    "https://*.moonshot.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://*.deepseek.com/*",
        "https://kimi.com/*",
        "https://*.kimi.com/*",
        "https://moonshot.cn/*",
        "https://*.moonshot.cn/*"
      ],
      "js": ["config.js", "rules.js", "state.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://*.deepseek.com/*",
        "https://kimi.com/*",
        "https://*.kimi.com/*",
        "https://moonshot.cn/*",
        "https://*.moonshot.cn/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Passport",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
